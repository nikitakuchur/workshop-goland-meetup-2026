package components

import (
	"cmp"
	"strconv"
	"workshop/internal/domain/sighting"
)

templ Gallery(items []sighting.Media) {
	if len(items) == 0 {
		<p class="gallery__empty">No media recorded.</p>
	} else {
		<ul
			class="gallery"
			if len(items) > 1 {
				tabindex="0"
				aria-label="Media, scroll sideways for more"
			}
		>
			for _, m := range items {
				<li class="gallery__item">
					<figure>
						if m.Type == "StillImage" {
							<img src={ m.URL } alt={ altText(m) } loading="lazy" decoding="async"/>
						} else {
							<a class="gallery__file" href={ templ.URL(m.URL) } rel="noopener">{ altText(m) }</a>
						}
						if m.Creator != "" {
							<figcaption class="gallery__credit">© { m.Creator }</figcaption>
						}
					</figure>
				</li>
			}
		</ul>
		if len(items) > 1 {
			<p class="gallery__count" aria-hidden="true">{ "+" + strconv.Itoa(len(items)-1) + " more" }</p>
		}
	}
}

func altText(m sighting.Media) string {
	return cmp.Or(m.Title, m.Description, "Sighting media")
}
